# PostgreSQL connection used by Prisma 7 and the Express API
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/sweety_db?schema=public"

# Express API port (defaults to 5000)
PORT=5000

# Replace with a long random secret for local development
JWT_SECRET=replace-with-a-long-random-development-secret

# jsonwebtoken duration, for example: 1d, 12h, or 3600s
JWT_EXPIRES_IN=1d
